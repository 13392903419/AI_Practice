# Blind for Navigation - environment template
# Usage:
# 1. Copy this file to .env
# 2. Fill in real API keys and model paths
# 3. Restart the backend after changing .env

# ==================== Required cloud services ====================

# DashScope API Key, used by ASR and cloud multimodal features.
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# AMap Web Service Key, used by destination geocoding and walking route planning.
AMAP_API_KEY=your_amap_web_service_key_here

# AMap JS API Key, used by the browser map view. Use a browser-side key when possible.
AMAP_JS_API_KEY=your_amap_js_api_key_here
AMAP_SECURITY_JS_CODE=
AMAP_PROVIDER=rest
AMAP_HTTP_TIMEOUT=5.0

# ==================== Runtime mode ====================

# Recommended for phone capture + PC inference.
RUNTIME_MODE=phone_priority
ACTIVE_VIDEO_SOURCE=phone
ACTIVE_AUDIO_SOURCE=phone

# ==================== Audio ====================

PC_MIC_AUTO_START=false
PC_TTS_PLAYBACK_ENABLED=false
MOBILE_TEXT_TTS_ONLY=false
STARTUP_ENABLE_AUDIO_TESTS=false
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural
EDGE_TTS_RATE=+0%

# ==================== Model loading ====================

STARTUP_PRELOAD_MODELS=true
USE_LOCAL_QWEN=false
DEVICE=cuda
CONFIDENCE_THRESHOLD=0.25

BLIND_PATH_MODEL=model/yolo-seg-nano.pt
OBSTACLE_MODEL=model/yoloe-11l-seg.pt
YOLOE_MODEL_PATH=model/yoloe-11l-seg.pt
TRAFFIC_LIGHT_MODEL=model/trafficlight.pt
SHOPPING_MODEL=model/shoppingbest5.pt
HAND_TASK_PATH=model/hand_landmarker.task

# ==================== Wake word and voiceprint ====================

# 0 keeps the ASR path open for development testing.
WAKE_ENABLED=0

# Set VOICEPRINT_DEBUG_ONLY=True first if you want to observe scores without blocking commands.
VOICEPRINT_ENABLED=True
VOICEPRINT_DEBUG_ONLY=False
VOICEPRINT_ENROLL_PATH=model/voiceprint.npz
VOICEPRINT_THRESHOLD=0.70
VOICEPRINT_VERIFY_SEC=3.5
VOICEPRINT_BUFFER_SEC=5.0
VOICEPRINT_INPUT_SR=16000

# ==================== Server ====================

SERVER_PORT=8081
LOG_LEVEL=INFO
DEBUG=false
ENABLE_CORS=false
CORS_ORIGINS=http://localhost:8081,http://localhost:3000
TZ=Asia/Shanghai
