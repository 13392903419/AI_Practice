# ================================================================
#  慧行 - 智能盲人导航眼镜系统 环境配置
#  项目：计算机软件创新设计大赛参赛作品
# ================================================================


# ======================== API 密钥 ========================
# 阿里云 DashScope API Key（用于语音识别 ASR + 云端多模态对话）
# 申请地址：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-82107b037f5847ee90deb81f6f976e0f
# Roboflow API Key（用于数据集管理，运行时非必需）
ROBOFLOW_API_KEY=3gCSF9FaAXdCDhs5F24M
# 高德地图 API Key（备用地图服务，运行时非必需）
AMAP_API_KEY=5ce8f46748edbd2531a74bcfa73a8624
#声纹识别是否启用
VOICEPRINT_ENABLED=True
VOICEPRINT_DEBUG_ONLY=False
VOICEPRINT_THRESHOLD=0.60
VOICEPRINT_VERIFY_SEC=3.5
VOICEPRINT_BUFFER_SEC=5.0
# ======================== AI 模型路径 ========================
# 盲道/斑马线分割模型（YOLO-Seg，核心导航模型）
BLIND_PATH_MODEL=model/yolo-seg-nano.pt

# 障碍物开放词汇检测模型（YOLO-E，支持任意类别检测）
OBSTACLE_MODEL=model/yoloe-11l-seg.pt
YOLOE_MODEL_PATH=model/yoloe-11l-seg.pt

# 红绿灯检测模型
TRAFFIC_LIGHT_MODEL=model/trafficlight.pt

# 物品查找分割模型
SHOPPING_MODEL=model/shoppingbest5.pt

# MediaPipe 手部关键点模型（物品查找时的手势引导）
HAND_TASK_PATH=model/hand_landmarker.task


# ======================== GPU 配置 ========================
# 指定使用的 GPU 编号（多卡环境下选择）
CUDA_VISIBLE_DEVICES=0


# ======================== 导航检测参数 ========================
AIGLASS_MASK_MIN_AREA=1500      # 最小掩码面积（像素），低于此值忽略噪声
AIGLASS_MASK_MORPH=3            # 形态学核大小，用于掩码平滑
AIGLASS_MASK_MISS_TTL=6         # 掩码丢失容忍帧数，超过后判定目标丢失
AIGLASS_PANEL_SCALE=0.65        # Web 端数据面板缩放比例


# ======================== 语音系统配置 ========================
# TTS 语音合成引擎：edge（免费，微软 Edge TTS）/ dashscope（阿里云）
TTS_ENGINE=edge

# 是否启用语音播报
ENABLE_TTS=true

# 语音播报最小间隔（秒），防止过于频繁
TTS_INTERVAL_SEC=3.0

# 对未识别指令是否用 TTS 回复
USE_TTS_FOR_UNKNOWN=True


# ======================== 多模态对话配置 ========================
# true = 使用本地 GPU 运行 Qwen2-VL-2B（需 8GB+ 显存）
# false = 使用云端 Qwen-Omni-Turbo API（推荐，需 DASHSCOPE_API_KEY）
USE_LOCAL_QWEN=true

# 本地模型路径（仅 USE_LOCAL_QWEN=true 时需要）
LOCAL_QWEN_MODEL_PATH=model/Qwen/Qwen2-VL-2B-Instruct